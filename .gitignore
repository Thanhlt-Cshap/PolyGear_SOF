## Ignore Visual Studio temporary files, build results, and
## user-specific files

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# VS Code settings folder
.vscode/

# Windows image file caches
Thumbs.db
ehthumbs.db

# VS backup and cache
*.bak
*.cache
*.tmp
*.vspscc
*.vssscc
*.dbmdl

# Rider
.idea/
*.sln.iml

# Visual Studio 2022/2019/2017 etc.
.vs/
Generated_Code/

# NuGet packages folder
*.nupkg
*.snupkg
*.nuspec
packages/
*.symbols.nupkg

# Publish output
publish/
out/

# Local test results
TestResults/
*.trx
*.coverage
*.coveragexml

# DotCover
.idea/.idea.DotSettings
.idea/.idea.DotSettings.user

# JetBrains Rider & ReSharper
.ReSharper*/
*.DotSettings.user

# Optional: ignore files generated by common tools
*.vsconfig
*.tlog
*.ipch
*.aps
*.ncb

# Optional: ignore database files
*.mdf
*.ldf
